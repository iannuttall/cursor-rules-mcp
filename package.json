{
  "name": "cursor-rules-mcp",
  "version": "0.0.3",
  "description": "MCP server for Cursor Rules",
  "bin": {
    "cursor-rules-mcp": "./dist/main.js"
  },
  "files": [
    "dist"
  ],
  "type": "module",
  "scripts": {
    "build": "tsc",
    "start": "node dist/main.js",
    "dev": "tsc -w",
    "ci": "npm run build",
    "prepublishOnly": "npm run ci",
    "postinstall": "echo '\nTo use cursor-rules-mcp, add this to your mcp.json file:\n\n\"cursor-rules-mcp\": {\n  \"command\": \"npx\",\n  \"args\": [\n    \"cursor-rules-mcp\"\n  ]\n}\n'"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.7.0",
    "@types/commander": "^2.12.0",
    "@types/fs-extra": "^11.0.4",
    "commander": "^13.1.0",
    "fs-extra": "^11.3.0",
    "undici": "^6.0.0",
    "zod": "^3.22.4"
  },
  "devDependencies": {
    "@types/node": "^20.10.0",
    "typescript": "^5.3.2"
  }
}
